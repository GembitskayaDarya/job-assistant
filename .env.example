# Required — docker-compose refuses to start without it, no default is provided on purpose.
POSTGRES_PASSWORD=
# Optional overrides, default to postgres/job_assistant if unset.
POSTGRES_USER=
POSTGRES_DB=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Automatic monitoring is disabled by default and requires TELEGRAM_ENABLED=true (JobMonitoringService
# needs a JobNotificationPort to deliver to). JOB_MONITORING_RECIPIENT_CHAT_ID has no default - it must
# be set to your own Telegram chat id if JOB_MONITORING_ENABLED=true.
JOB_MONITORING_ENABLED=false
JOB_MONITORING_FIXED_DELAY=30m
JOB_MONITORING_INITIAL_DELAY=1m
JOB_MONITORING_KEYWORD=java backend
JOB_MONITORING_MINIMUM_SCORE=70
JOB_MONITORING_MAX_NOTIFICATIONS=5
JOB_MONITORING_RECIPIENT_CHAT_ID=

# Set to DEBUG to see per-run scheduler/monitoring logs (start, duration, summary counts).
LOG_LEVEL_SCHEDULER=INFO
LOG_LEVEL_MONITORING=INFO
